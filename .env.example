# ==========================================
# EVOLVEVITA FRONTEND CONFIGURATION (.env)
# ==========================================

# Live FastAPI backend URL (defaults to http://127.0.0.1:8001 if omitted)
VITE_API_URL=http://127.0.0.1:8001

# Optional: Firebase Authentication (Google Sign-In & Email/Password)
# If left blank, EvolveVita automatically uses its built-in local authentication engine & demo accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
