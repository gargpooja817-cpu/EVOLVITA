{
  "name": "evolvita-cap",
  "version": "1.0.0",
  "description": "EvolveVita SAP CAP Service Layer — OData V4 + HANA Cloud",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "cds serve --production",
    "build": "cds build --production",
    "watch": "cds watch",
    "deploy:hana": "cds deploy --to hana",
    "deploy:sqlite": "cds deploy --to sqlite"
  },
  "dependencies": {
    "@sap/cds": "^7.9.0",
    "@sap/hana-client": "^2.21.0",
    "express": "^4.18.2",
    "hdb": "^0.19.8",
    "@sap/xssec": "^3.6.0",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^7.9.0",
    "@cap-js/hana": "^1.3.0",
    "@cap-js/sqlite": "^1.7.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana-cloud",
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "database": ":memory:"
          }
        }
      },
      "auth": {
        "kind": "dummy",
        "[production]": {
          "kind": "xsuaa"
        }
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  }
}
